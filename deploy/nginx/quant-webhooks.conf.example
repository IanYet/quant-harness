server {
    listen 443 ssl;
    server_name quant.example.com;
    ssl_certificate /etc/letsencrypt/live/quant.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quant.example.com/privkey.pem;

    client_max_body_size 256k;

    location = /webhooks/telegram/notifier {
        proxy_pass http://127.0.0.1:18101/webhooks/telegram;
        proxy_read_timeout 5s;
    }

    location = /webhooks/feishu/notifier {
        proxy_pass http://127.0.0.1:18101/webhooks/feishu;
        proxy_read_timeout 5s;
    }

    location / {
        return 404;
    }
}
